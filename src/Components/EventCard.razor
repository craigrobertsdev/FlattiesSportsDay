@using Microsoft.AspNetCore.Authorization
@using SportsDayScoring.Components.Pages
@using SportsDayScoring.Models
@using static AppConstants

@inject NavigationManager NavManager

@attribute [Authorize]

<div class="rounded-2xl border @(HouseEvent.IsSaved ? "border-green-200 bg-green-50" : "border-slate-200 bg-white") shadow-sm overflow-hidden">
    @* Event title bar *@
    <div class="flex items-center justify-between px-3 py-2 border-b @(HouseEvent.IsSaved ? "border-green-200 bg-green-100" : "border-slate-100 bg-slate-50")">
        <h3 class="font-bold text-sm text-slate-800">@HouseEvent.Name</h3>
        @if (HouseEvent.IsSaved)
        {
            <span class="text-xs font-bold text-green-700 bg-green-200 rounded-full px-2 py-0.5">✓ Saved</span>
        }
        else if (_isError)
        {
            <span class="text-xs font-bold text-red-700 bg-red-100 rounded-full px-2 py-0.5">Fill all scores</span>
        }
    </div>

    @* House rows *@
    <div class="divide-y divide-slate-100">
        @for (int i = 0; i < HouseNames.Length; i++)
        {
            var idx = i;
            var houseName = HouseNames[idx];

            <div class="flex items-center gap-2 px-3 py-1.5">
                @* House colour chip *@
                <div class="w-2.5 h-6 rounded-full @(HouseStyles[houseName].BackgroundColour) flex-shrink-0"></div>
                <span class="w-16 text-xs font-semibold text-slate-700">@houseName</span>

                @if (HouseEvent.IsSaved)
                {
                    <span class="flex-1 text-right text-xs text-slate-600">
                        Athletic: <strong>@HouseEvent.ScoreCards.Get(houseName).AthleticPoints</strong>
                    </span>
                    <span class="text-right text-xs text-slate-600">
                        Spirit: <strong>@HouseEvent.ScoreCards.Get(houseName).SpiritPoints</strong>
                    </span>
                }
                else
                {
                    <select class="flex-1 rounded-lg @(HouseStyles[houseName].BackgroundColour) border-0 text-white text-xs font-semibold py-1.5 px-1 text-center"
                            @onchange=@((e) => HandleAthleticScoreChange(e, houseName))>
                        <option disabled hidden selected>Athletic</option>
                        @foreach (var score in AppConstants.AthleticScores)
                        {
                            <option value="@score">@score</option>
                        }
                    </select>
                    <select class="flex-1 rounded-lg @(HouseStyles[houseName].BackgroundColour) border-0 text-white text-xs font-semibold py-1.5 px-1 text-center"
                            @onchange=@((e) => HandleSpiritScoreChange(e, houseName))>
                        <option disabled hidden selected>Spirit</option>
                        @foreach (var score in AppConstants.SpiritScores)
                        {
                            <option value="@score">@score</option>
                        }
                    </select>
                }
            </div>
        }
    </div>

    @* Save button *@
    @if (!HouseEvent.IsSaved)
    {
        <div class="px-3 py-2 border-t border-slate-100">
            <button class="w-full rounded-xl py-2 text-xs font-bold text-white @(_isError ? "bg-red-500" : "bg-green-600")"
                    @onclick="SaveScores">
                Save Scores
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public ClassEvents Parent { get; set; } = null!;
    [Parameter] public HouseEvent HouseEvent { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    private bool _isError;

    private async Task SaveScores()
    {
        _isError = false;
        if (HouseEvent.ScoreCards.Any(v => v.AthleticPoints == 0))
        {
            _isError = true;
            return;
        }

        try
        {
            await Parent.DataService.UpdateHouseEvent(HouseEvent);
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }

        RefreshPage();
    }

    private void HandleAthleticScoreChange(ChangeEventArgs e, HouseName houseName)
    {
        HouseEvent.ScoreCards.Get(houseName).AthleticPoints = int.Parse((string)e.Value!);
        StateHasChanged();
    }

    private void HandleSpiritScoreChange(ChangeEventArgs e, HouseName houseName)
    {
        HouseEvent.ScoreCards.Get(houseName).SpiritPoints = int.Parse((string)e.Value!);
        StateHasChanged();
    }

    private void RefreshPage()
    {
        NavManager.NavigateTo($"/class-events/{Parent.RoomNumber}", true);
    }

}