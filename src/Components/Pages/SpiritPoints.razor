@page "/spirit"
@using Microsoft.AspNetCore.Authorization
@using SportsDayScoring.Models
@using static AppConstants
@using SportsDayScoring.Data

@inject NavigationManager NavigationManager
@attribute [Authorize]

@* Page header *@
<div class="flex items-center gap-2 mb-3">
    <a href="/" class="rounded-xl bg-white border border-slate-200 px-2 py-1.5 text-sm text-slate-600 shadow-sm">← Back</a>
    <h1 class="text-lg font-bold">Spirit Points</h1>
</div>

<div class="flex flex-col gap-2">
    @for (int i = 0; i < HouseNames.Length; i++)
    {
        var idx = i;
        var houseName = HouseNames[idx];
        var score = _scores[houseName];

        <div class="rounded-2xl @(HouseStyles[houseName].BackgroundColour) px-4 py-2.5 shadow-sm flex items-center justify-between">
            <span class="text-sm font-bold text-white drop-shadow">@houseName</span>
            <div class="flex items-center gap-3">
                <button class="w-8 h-8 rounded-full bg-white bg-opacity-30 text-white font-bold text-lg leading-none"
                        @onclick="() => Decrement(houseName)">−</button>
                <span class="text-xl font-bold text-white w-8 text-center drop-shadow">@score</span>
                <button class="w-8 h-8 rounded-full bg-white bg-opacity-30 text-white font-bold text-lg leading-none"
                        @onclick="() => Increment(houseName)">+</button>
            </div>
        </div>
    }
</div>

<div class="mt-3 flex flex-col gap-2">
    <button class="w-full rounded-2xl bg-green-600 py-2.5 text-sm font-bold text-white shadow-sm" @onclick="SaveScores">
        ✓ Save Spirit Points
    </button>
    <a href="/" class="w-full rounded-2xl bg-white border border-slate-200 py-2.5 text-sm font-bold text-slate-600 shadow-sm text-center block">
        Cancel
    </a>
</div>

@code {
    [Inject] public DataService DataService { get; set; } = null!;
    private List<HouseSpirit> _houses = [];
    private Dictionary<HouseName, int> _scores = new();

    protected override async Task OnInitializedAsync()
    {
        _houses = await DataService.GetHouseSpirit();
        foreach (var houseName in HouseNames)
            _scores[houseName] = 0;
    }

    private void Increment(HouseName houseName)
    {
        _scores[houseName] = Math.Min(_scores[houseName] + 10, 40);
        StateHasChanged();
    }

    private void Decrement(HouseName houseName)
    {
        _scores[houseName] = Math.Max(_scores[houseName] - 10, 0);
        StateHasChanged();
    }

    private async Task SaveScores()
    {
        foreach (var houseName in HouseNames)
            _houses.First(h => h.Name == houseName).SpiritScore += _scores[houseName];

        await DataService.UpdateHouseSpirit(_houses);
        NavigationManager.NavigateTo("/");
    }
}
