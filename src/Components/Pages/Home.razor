@page "/"
@using Microsoft.AspNetCore.Authorization
@using SportsDayScoring.Data
@using static AppConstants
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@attribute [Authorize]

<PageTitle>Home</PageTitle>

<div class="flex flex-col gap-3">

    @* Header *@
    <header class="rounded-2xl bg-gradient-to-br from-blue-600 to-blue-800 px-4 py-3 text-center text-white shadow-md">
        <h1 class="text-xl font-bold leading-tight">🏆 McLaren Flat Sports Day 🏆</h1>
        <p class="text-blue-200 text-xs font-medium">@(DateTime.Now.Year)</p>
    </header>

    @* Class Events *@
    <div class="rounded-2xl bg-white shadow-sm border border-slate-200 px-3 py-2 flex flex-col gap-2">
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Class Events</p>
        <div class="flex gap-2">
            <select @bind="SelectedRoom"
                    class="flex-1 rounded-xl border-2 border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold focus:border-blue-400 focus:outline-none">
                <option selected disabled hidden>Select room…</option>
                @foreach (var room in RoomNumbers)
                {
                    <option value="@room">Room @room</option>
                }
            </select>
            <button @onclick="GoToClassEvents" disabled="@(SelectedRoom == null)"
                    class="rounded-xl px-4 py-2 text-sm font-bold shadow-sm @(SelectedRoom == null ? "bg-slate-200 text-slate-400" : HouseStyles[HouseNames[0]].BackgroundColour + " text-white")">
                Go →
            </button>
        </div>
    </div>

    @* Main nav buttons *@
    <div class="flex flex-col gap-2 px-6">
        <button @onclick="GoToSchoolEvents"
                class="flex items-center gap-3 rounded-2xl border-0 px-4 py-2.5 text-left text-sm font-bold shadow-sm @(HouseStyles[HouseNames[1]].BackgroundColour) text-white">
            <span class="text-xl">🏫</span>
            <span>Whole School Events</span>
        </button>
        <button @onclick="GoToSpirit"
                class="flex items-center gap-3 rounded-2xl border-0 px-4 py-2.5 text-left text-sm font-bold shadow-sm @(HouseStyles[HouseNames[2]].BackgroundColour) text-white">
            <span class="text-xl">⭐</span>
            <span>Award Spirit Points</span>
        </button>
        <button @onclick="GoToScores"
                class="flex items-center gap-3 rounded-2xl border-0 px-4 py-2.5 text-left text-sm font-bold shadow-sm @(HouseStyles[HouseNames[3]].BackgroundColour)">
            <span class="text-xl">📊</span>
            <span>Leaderboard</span>
        </button>
    </div>

    @* Danger zone *@
    <details class="rounded-2xl border border-red-200 bg-red-50">
        <summary class="cursor-pointer list-none px-3 py-2 text-sm font-semibold text-red-700 select-none">
            ⚠️ Danger zone
        </summary>
        <div class="px-3 pb-3">
            <p class="mb-2 text-xs text-red-600">Resetting will clear all scores. This cannot be undone.</p>
            <button @onclick="OpenDialog"
                    class="w-full rounded-xl bg-red-700 px-4 py-2 text-sm font-bold text-white shadow-sm">
                Reset all data
            </button>
        </div>
    </details>

</div>

<dialog id="dialog" class="w-80 rounded-2xl p-4 shadow-xl">
    <h2 class="text-base font-bold text-slate-800 mb-1">Are you sure?</h2>
    <p class="mb-3 text-sm text-slate-500">This will reset all scores for the day and cannot be undone.</p>
    <div class="flex gap-2">
        <button class="flex-1 rounded-xl bg-red-700 py-2 text-sm font-bold text-white" @onclick="ConfirmResetData">Yes, reset</button>
        <button class="flex-1 rounded-xl bg-slate-200 py-2 text-sm font-bold text-slate-700" @onclick="CloseDialog">Cancel</button>
    </div>
</dialog>

@code {
    [Inject] ApplicationDbContext Context { get; set; } = null!;
    int? SelectedRoom { get; set; } = null;

    void GoToClassEvents()
    {
        NavigationManager.NavigateTo($"/class-events/{SelectedRoom}");
    }

    private async Task SeedData()
    {
        var seed = new Seed(Context);
        await seed.SeedData();
    }

    private void GoToSchoolEvents()
    {
        NavigationManager.NavigateTo("/school-events");
    }

    private void GoToSpirit()
    {
        NavigationManager.NavigateTo("/spirit");
    }

    private void GoToScores()
    {
        NavigationManager.NavigateTo("/scores");
    }

    private async Task OpenDialog()
    {
       await JSRuntime.InvokeVoidAsync("openDialog");
    }

    private async Task ConfirmResetData()
    {
        await SeedData();
        await JSRuntime.InvokeVoidAsync("closeDialog");
    }

    private async Task CloseDialog()
    {
        await JSRuntime.InvokeVoidAsync("closeDialog");
    }
}
