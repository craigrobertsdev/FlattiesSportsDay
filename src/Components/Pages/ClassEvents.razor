@page "/class-events/{roomNumber:int}"
@using Microsoft.AspNetCore.Authorization
@using SportsDayScoring.Data
@using SportsDayScoring.Models
@rendermode InteractiveServer

@attribute [Authorize]

@* Page header *@
<div class="flex items-center gap-2 mb-3">
    <a href="/" class="rounded-xl bg-white border border-slate-200 px-2 py-1.5 text-sm text-slate-600 shadow-sm">← Back</a>
    <div>
        <h1 class="text-lg font-bold">Room @RoomNumber</h1>
        @if (Room is not null)
        {
            var done = Room.HouseEvents.Count(e => e.IsSaved);
            <p class="text-xs text-slate-500">@done / @Room.HouseEvents.Count events complete</p>
        }
    </div>
</div>

@if (_error != null)
{
    <div class="rounded-xl bg-red-50 border border-red-200 px-3 py-2 text-xs text-red-700 mb-3">@_error</div>
}

@if (Room is null)
{
    <div class="text-center text-slate-400 py-6">Loading…</div>
}
else
{
    <div class="flex flex-col gap-3">
        @foreach (var ev in Room.HouseEvents)
        {
            <EventCard HouseEvent="@ev" Parent="this"/>
        }
    </div>
}

@code {
    [Parameter] public int RoomNumber { get; set; }
    [Inject] public DataService DataService { get; set; } = null!;

    private Room? Room { get; set; }
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var room = await DataService.GetRoom(RoomNumber);
            Room = room;
            OnEventSaved();
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private void OnEventSaved()
    {
        if (Room is null) return;

        var idx = 0;
        while (Room.HouseEvents[idx].IsSaved)
        {
            idx++;
            if (idx == Room.HouseEvents.Count) { idx = 0; break; }
        }

        var orderedEvents = new List<HouseEvent>();
        while (orderedEvents.Count < Room.HouseEvents.Count)
        {
            orderedEvents.Add(Room.HouseEvents[idx]);
            idx++;
            if (idx == Room.HouseEvents.Count) idx = 0;
        }

        Room.HouseEvents = orderedEvents;
        StateHasChanged();
    }
}
